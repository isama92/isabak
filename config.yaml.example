domain: "yourdomain.com"
destination: "/home/user/backups"
allow_destination_on_root_fs: false
mysql:
  container: "mysql"
  username: "username"
  password: "password"
mariadb:
  container: "mariadb"
  username: "username"
  password: "password"
postgres:
  image: "prodrigestivill/postgres-backup-local:17@sha256:<digest>"
services:
  - name: your_service
    fs:
      folder: "/home/user/your_service_files"
      exclude:
        - "/cache"
        - "/logs"
      include:
        - "/keep_this_dir/***"
    mysql:
      db_name: "your_service_db"
    mariadb:
      db_name: "your_service_db"
    postgres:
      container: "postgres"
      network: "postgres"
      username: "username"
      password: "password"
      db_name: "your_service_db"
    arr:
      endpoint: "/api/v3"
      subdomain: "radarr"
      api_key: "api-key"
      folder: "/home/user/your_service_files/arr_generated_backups"
      secure: true
    jellyfin:
      subdomain: "jellyfin"
      api_key: "api-key"
      folder: "/home/user/your_service_files/jellyfin_generated_backups"
      secure: true
      options:
        database: true
        metadata: false
        trickplay: false
        subtitles: false
    sqlite:
      files:
        - "/home/user/your_service_files/data/app.db"
borg:
  repository: "ssh://user@host:/"
  passphrase: "your-passphrase"
  keep:
    daily: 7
    weekly: 4
    monthly: 3
    partial_days: 7
  folders:
    - repository: "/docker-services"
      folder: "/home/user/backups"
      compression: "zstd,9"
    - repository: "/pictures"
      folder: "${DATA_PATH}/Pictures"
    - repository: "/homes"
      folder: "/home"
      compression: "none"
